[Unit]
Description=OEM dashboard startup (apply deploy / sync with GitHub, then run dashboard)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# The Pi's user. deploy/pi-setup.sh replaces this with pi.user from config.json.
User=oem
# "~" is User='s home; startup.py and startup_config.json live in ~/startup.
WorkingDirectory=~
ExecStart=/usr/bin/python3 startup/startup.py
# startup.py restarts the dashboard itself. Don't let systemd restart
# startup.py, or a crash would re-run the GitHub sync and undo a deploy.
Restart=no
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
